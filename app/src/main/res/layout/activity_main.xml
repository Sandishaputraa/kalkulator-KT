<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a"
    android:padding="20dp"
    android:gravity="bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_weight="1"
        android:justifyContent="flex-end"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#64748b"
            android:textSize="20sp"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#f8fafc"
            android:textSize="48sp"
            android:text="0"
            android:maxLines="1"
            android:ellipsize="start"/>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <Button
            android:id="@+id/btnC"
            android:text="C"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_clear"
            android:textColor="#f87171"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnDel"
            android:text="DEL"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_operator"
            android:textColor="#60a5fa"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnMod"
            android:text="%"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_operator"
            android:textColor="#60a5fa"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnDiv"
            android:text="÷"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_operator"
            android:textColor="#60a5fa"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn7"
            android:text="7"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btn8"
            android:text="8"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btn9"
            android:text="9"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btnMul"
            android:text="×"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_operator"
            android:textColor="#60a5fa"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn4"
            android:text="4"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btn5"
            android:text="5"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btn6"
            android:text="6"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btnSub"
            android:text="-"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_operator"
            android:textColor="#60a5fa"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn1"
            android:text="1"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btn2"
            android:text="2"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btn3"
            android:text="3"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btnAdd"
            android:text="+"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_operator"
            android:textColor="#60a5fa"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn0"
            android:text="0"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btnDot"
            android:text="."
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_button"
            android:textColor="#e2e8f0"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btnEqual"
            android:text="="
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_equal"
            android:textColor="#34d399"
            android:textSize="26sp"
            android:textStyle="bold"/>

    </GridLayout>
</LinearLayout>
